        },
        {
          "entity": "teilnehmende",
          "op": "create",
          "fields": [
            "veranstaltung",
            "kuerzel",
            "email",
            "einwilligung"
          ]
        },
        {
          "entity": "feedbacks",
          "op": "create",
          "fields": [
            "interaktion",
            "teilnehmer",
            "feedbacktext",
            "absende_schluessel"
          ]
